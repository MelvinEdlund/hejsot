# ───────────────────────────────────────────────────────────────
#  hejsöt — environment variables
#  Copy to .env.local for local dev. In production set these in
#  Vercel → Project → Settings → Environment Variables.
#  NEVER commit real values.
# ───────────────────────────────────────────────────────────────

# Public base URL of the site (used to build invite links + OG tags).
# Local: http://localhost:3000   Prod: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────
# Project URL + anon key are public (anon is only used client-side
# for uploading hero images to Storage).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key is SERVER ONLY. It bypasses RLS and must never be
# exposed to the browser. Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth (hidden admin) ───────────────────────────────────────
# The only account that can sign in. No public signup exists.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long-and-random

# Secret used to sign session cookies (JWT). Min 32 chars.
# Generate one: `openssl rand -base64 48`
AUTH_SECRET=generate-a-long-random-string-at-least-32-chars

# ── Email (Resend) ────────────────────────────────────────────
# https://resend.com — leave RESEND_API_KEY empty to log emails to
# the server console instead of sending (handy before DNS is set up).
RESEND_API_KEY=
RESEND_FROM_EMAIL=hejsöt <hej@yourdomain.com>

# ── Rate limiting (optional, recommended for production) ──────
# If set, rate limiting uses Upstash Redis (works across serverless
# instances + the edge). If unset, falls back to in-memory (fine for
# a single instance / local dev). https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
